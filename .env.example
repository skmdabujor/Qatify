# ==============================================================================
# QATIFY ENVIRONMENT VARIABLES (BACKEND: CONVEX & POLAR)
# ==============================================================================

# Next.js Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Convex Deployment (Created automatically when running `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Polar 2026-10 Payment Gateway (https://polar.sh & https://sandbox.polar.sh)
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=polar_oat_your_access_token_here
POLAR_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# Resend Email Delivery (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Admin Authentication Secret (Generate a 32+ character random hex key)
ADMIN_SECRET_KEY=your_secure_admin_secret_key_here

